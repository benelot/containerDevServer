# ── MLflow Tracking Server ────────────────────────────────────────────────────
MLFLOW_PORT=5000
MLFLOW_VERSION=2.16.0

# ── PostgreSQL (MLflow backend store) ─────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow_secret
POSTGRES_DB=mlflow

# ── MinIO (S3-compatible artifact store) ──────────────────────────────────────
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_BUCKET=mlflow

# ── Docker Compose project name ───────────────────────────────────────────────
COMPOSE_PROJECT_NAME=mlflow-stack
