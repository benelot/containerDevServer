# ── Label Studio ──────────────────────────────────────────────────────────────
LABEL_STUDIO_PORT=8080
LABEL_STUDIO_USERNAME=admin@example.com
LABEL_STUDIO_PASSWORD=changeme

# ── PostgreSQL backend ────────────────────────────────────────────────────────
POSTGRES_PORT=5433
