# ── BentoML serving ───────────────────────────────────────────────────────────
BENTOML_PORT=3001

# MLflow registry to pull the model from
MLFLOW_TRACKING_URI=http://host.docker.internal:5000
MLFLOW_S3_ENDPOINT_URL=http://host.docker.internal:9000
MLFLOW_MODEL_NAME=mnist1d-conv1d
MLFLOW_MODEL_STAGE=Production

# MinIO credentials (used to download model artifacts from MLflow)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret

# ── Docker Compose project name ───────────────────────────────────────────────
COMPOSE_PROJECT_NAME=bentoml-stack
