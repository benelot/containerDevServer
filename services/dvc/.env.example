# ── MinIO (DVC S3 remote cache) ───────────────────────────────────────────────
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_BUCKET=dvc-cache

# ── Docker Compose project name ───────────────────────────────────────────────
COMPOSE_PROJECT_NAME=dvc-stack
