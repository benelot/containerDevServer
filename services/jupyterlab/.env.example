# ── JupyterLab ────────────────────────────────────────────────────────────────
JUPYTER_PORT=8888
# Token for notebook access. Set to empty string to disable auth (dev only).
JUPYTER_TOKEN=changeme
# Image tag -- datascience-notebook includes Python, R, and Julia kernels.
# Use jupyter/minimal-notebook for a lighter image without R/Julia.
JUPYTER_IMAGE=jupyter/datascience-notebook:latest

# ── Docker Compose project name ───────────────────────────────────────────────
COMPOSE_PROJECT_NAME=jupyterlab-stack

# ── MLflow / MinIO connectivity (host seen from inside the container) ─────────
# host.docker.internal resolves to the host on Mac/Windows Docker Desktop.
# On Linux it is mapped via extra_hosts in docker-compose.yml.
MLFLOW_TRACKING_URI=http://host.docker.internal:5000
MLFLOW_S3_ENDPOINT_URL=http://host.docker.internal:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
