# ── Dagster webserver ─────────────────────────────────────────────────────────
DAGSTER_PORT=3000

# ── PostgreSQL (Dagster run/event/schedule storage) ───────────────────────────
POSTGRES_PORT=5434
POSTGRES_USER=dagster
POSTGRES_PASSWORD=dagster_secret
POSTGRES_DB=dagster

# ── MLflow reachability from inside the container ─────────────────────────────
MLFLOW_TRACKING_URI=http://host.docker.internal:5000
MLFLOW_S3_ENDPOINT_URL=http://host.docker.internal:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret

# ── Docker Compose project name ───────────────────────────────────────────────
COMPOSE_PROJECT_NAME=dagster-stack
